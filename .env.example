# Copy to .env and fill in what you use. .env is ignored by git and never leaves your machine.

# Free model (default when set): https://console.groq.com/keys
GROQ_API_KEY=

# Optional, paid per use: https://console.anthropic.com
ANTHROPIC_API_KEY=

# auto picks Groq, then Claude, then the offline engine. Or force one: groq, claude, offline.
CARDPILOT_ENGINE=auto

# sqlite needs no setup. postgres needs CARDPILOT_DATABASE_URL and the pgvector extension.
CARDPILOT_STORE=sqlite
# CARDPILOT_DATABASE_URL=postgresql://postgres:cardpilot@localhost:5432/postgres

# glove ships inside the package. bge-small is stronger: uv sync --extra embeddings, downloads once.
CARDPILOT_EMBEDDER=glove

# Optional tracing. Langfuse (uv sync --extra tracing):
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# or LangSmith, no extra install:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
